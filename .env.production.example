# ============================================================
# AI Career Intelligence — Production Environment Configuration
# ============================================================

# --- Core Application ---
APP_NAME="AI Career Intelligence"
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# --- Security ---
# Generated 64-char cryptographically secure key
SECRET_KEY=9f8e7d6c5b4a392817263544536271829304a5b6c7d8e9f0123456789abcdef0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
POSTGRES_DB=ai_career_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_production_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_production_password_2026@db:5432/ai_career_db
DATABASE_ECHO=false

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- ChromaDB ---
CHROMA_PORT=8001
CHROMA_HOST=chromadb
CHROMA_PERSIST_DIR=/app/data/chromadb

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- HuggingFace Embeddings ---
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage ---
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS & Networking ---
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Admin Credentials ---
ADMIN_EMAIL=admin@careerintelligence.ai
ADMIN_PASSWORD=EnterpriseProductionAdmin2026!#
