# ============================================================
# AI Career Intelligence — Backend Environment Variables (.env.example)
# ============================================================
# Copy this file to .env and replace placeholder values with your environment configuration.
# NEVER commit the actual .env file or real secrets to source control.

# --- Application ---
APP_NAME="AI Career Intelligence"
# APP_ENV: 'development' or 'production' (in production, DEBUG is disabled and strict security checks apply)
APP_ENV=development
# DEBUG: Must be 'false' in production
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Security ---
# Generate a cryptographically secure key: openssl rand -hex 32
# Must be at least 32 characters in production
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/ai_career_db
DATABASE_ECHO=false

# --- Redis (Cache & Session) ---
REDIS_URL=redis://localhost:6379/0

# --- ChromaDB (Vector Store) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb

# --- Google Gemini AI API ---
# Provide your Google Gemini API key (e.g. AIzaSy...)
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- HuggingFace Embedding Model ---
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- File Storage & Upload Limits ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS (Allowed Frontend Origins) ---
# JSON array of origins or comma-separated URLs. Never use '*' with credentials in production.
CORS_ORIGINS=["http://localhost:3000","https://your-production-domain.com"]

# --- Initial Admin Setup ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password-here
