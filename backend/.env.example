# ==============================================================
# AI Career Intelligence — Backend Environment Template
# Copy to .env and fill in real values before starting backend
# ==============================================================

# Application
APP_NAME="AI Career Intelligence"
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET_KEY_HERE

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED: PostgreSQL connection string from Render/Railway/Neon
# Format: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=REPLACE_WITH_POSTGRES_CONNECTION_STRING

DATABASE_ECHO=false

# Optional Redis (leave empty to disable)
REDIS_URL=

# ChromaDB (local embedded - no separate service needed)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=/app/data/chromadb

# OPTIONAL: Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY_OR_LEAVE_EMPTY
GEMINI_MODEL=gemini-2.0-flash

# Embeddings
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File Storage
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=10

# REQUIRED: Add your frontend URL after deploying to Vercel/Netlify
# Example: '["https://your-app.vercel.app","https://your-custom-domain.com"]'
CORS_ORIGINS=["https://your-frontend-url.vercel.app"]

# Admin user (auto-created on startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
